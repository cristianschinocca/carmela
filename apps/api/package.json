{
  "name": "@mistro/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "auth:schema:reference": "auth generate --config src/auth.ts --output ../../packages/db/prisma/auth.reference.prisma --yes",
    "auth:create-admin": "auth create-admin --config src/auth.ts",
    "workspace:provision": "tsx src/scripts/provisionWorkspace.ts",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "better-auth": "1.7.25",
    "@better-auth/prisma-adapter": "1.7.25",
    "@mistro/db": "workspace:*",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "auth": "1.7.25",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3"
  }
}
